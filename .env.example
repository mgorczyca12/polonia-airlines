# Copy to .env and supply local development passwords. Never commit .env.
POSTGRES_USER=polonia
POSTGRES_PASSWORD=
RABBITMQ_USER=polonia
RABBITMQ_PASSWORD=

# Web server only; never expose the session password as a VITE_ variable.
WEB_SESSION_PASSWORD=
WEB_ORIGIN=http://localhost:8080

# Optional: used only with compose.telemetry.yaml. Keep the ingest key in .env.
HONEYCOMB_API_KEY=
HONEYCOMB_ENDPOINT=https://api.honeycomb.io
HONEYCOMB_METRICS_DATASET=polonia-metrics
OTEL_HEALTH_PORT=13133

WEB_PORT=8080
FLIGHT_PORT=5101
BOOKING_PORT=5102
SEATING_PORT=5103
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
